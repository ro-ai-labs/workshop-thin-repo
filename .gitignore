# Build artifacts / local-only
/build/
/dist/
/.local/
*.tar
*.tar.gz

# build-context/claude-plugins/ IS committed — it's how participants get the
# plugins baked into the image when they build the devcontainer locally.
# Refresh via `scripts/prepare-build-context.sh` whenever host plugins change.

# Demo repos — cloned into here by .devcontainer/post-create.sh at first reopen.
# Lives on the host filesystem via the workspace bind-mount, so edits persist.
/workshop/

# Editor / OS
.DS_Store
.vscode/settings.json
.idea/

# Secrets / env
.env
.env.local
*.pem
