# Build artifacts / local-only
/build/
/dist/
/.local/
*.tar
*.tar.gz

# build-context/ is unused (plugins are no longer baked into the image -
# participants install them manually via `/plugin add` inside the container).
/build-context/

# Demo repos - cloned into here by .devcontainer/post-create.sh at first reopen.
# Lives on the host filesystem via the workspace bind-mount, so edits persist.
/workshop/

# Editor / OS
.DS_Store
.vscode/settings.json
.idea/

# Secrets / env
.env
.env.local
*.pem
