{
  "name": "ITSS Workshop 2026",
  // No registry dependency: participants build this image locally on first
  // "Reopen in Container" (~10-15 min, then cached for subsequent opens).
  // The build context is the workspace root (one level up from this file) so
  // the Dockerfile's `COPY build-context/claude-plugins/...` resolves.
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  // OFFLINE FALLBACK: if your `docker build` keeps failing (workshop wifi,
  // proxy, etc.) and Mihai handed you the tarball on USB:
  //   docker load -i itss-workshop-2026.05.28.tar
  // Then comment out the "build" block above and uncomment the line below:
  // "image": "itss-workshop:local",

  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": true
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "vscode",
      "userUid": "automatic",
      "userGid": "automatic"
    }
  },

  "remoteUser": "vscode",
  "updateRemoteUserUID": true,

  "mounts": [
    // Whole-home named volume - single source of robustness for everything
    // user-side (auth, plugins, shell history, nvm, claude CLI, playwright cache).
    //
    // Why a volume instead of host bind mounts:
    //   Docker Desktop on WSL2 snapshots each *file*-level WSL→container bind
    //   into /run/desktop/mnt/host/wsl/docker-desktop-bind-mounts/<distro>/<hash>.
    //   That snapshot dir is wiped on every Docker Desktop or WSL restart, and
    //   `docker start` then fails with "no such file or directory" on the cached
    //   hash path. Named volumes live in Docker's own storage - unaffected.
    //
    // Behaviour vs. the previous bind-mount setup:
    //   • Auth no longer syncs host ↔ container. Run `claude login` once inside
    //     the container; the volume preserves the token across restarts and
    //     rebuilds. Host's ~/.claude is independent.
    //   • First container creation populates the volume from the image's
    //     /home/vscode (nvm, Claude CLI, Playwright Chromium cache, etc.).
    //   • Subsequent rebuilds reuse the existing volume - Dockerfile changes
    //     that touch /home/vscode won't propagate. To force a fresh home:
    //         docker volume rm itss-workshop-home
    "source=itss-workshop-home,target=/home/vscode,type=volume",

    // Volumes outside /home/vscode - preserve heavy build artifacts across rebuilds:
    //   • cargo registry + git caches (codex's `cargo fetch` results)
    //   • Docker-in-Docker's storage (Twenty's Postgres data + compose state)
    "source=itss-workshop-cargo,target=/usr/local/cargo,type=volume",
    "source=itss-workshop-dind,target=/var/lib/docker,type=volume"
  ],

  "containerEnv": {
    "WORKSHOP_HOME": "${containerWorkspaceFolder}/workshop",
    "EDITOR": "code --wait",
    "TZ": "Europe/Bucharest"
  },
  "remoteEnv": {
    "GIT_AUTHOR_NAME":  "${localEnv:GIT_AUTHOR_NAME}",
    "GIT_AUTHOR_EMAIL": "${localEnv:GIT_AUTHOR_EMAIL}"
  },

  "userEnvProbe": "loginInteractiveShell",
  "hostRequirements": { "cpus": 4, "memory": "8gb", "storage": "32gb" },

  "forwardPorts": [3000, 3001, 3002],
  "portsAttributes": {
    "3000": { "label": "Twenty backend",  "onAutoForward": "silent" },
    "3001": { "label": "Twenty frontend", "onAutoForward": "openBrowser" },
    "3002": { "label": "Live Preview",    "onAutoForward": "silent" }
  },

  "postCreateCommand": "bash ${containerWorkspaceFolder}/.devcontainer/post-create.sh",
  "postStartCommand":  "bash ${containerWorkspaceFolder}/.devcontainer/post-start.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "ms-vscode.live-server",
        "ms-azuretools.vscode-docker",
        "rust-lang.rust-analyzer",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "redhat.vscode-yaml",
        "GitHub.vscode-pull-request-github"
      ],
      "settings": {
        "livePreview.serverRoot": "${containerWorkspaceFolder}/workshop",
        "livePreview.portNumber": 3002,
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
